<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="#1B1B1B">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="📦 Comandas" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="19sp"/>
        <TextView android:id="@+id/widget_comanda_counter" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="0/1 conferidas" android:textColor="#BDBDBD" android:textSize="13sp"/>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="10dp" android:layout_marginBottom="8dp" android:background="#444444"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.5" android:text="COMANDA" android:textColor="#BDBDBD" android:textStyle="bold" android:textSize="12sp"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="TAXA" android:textColor="#BDBDBD" android:textStyle="bold" android:textSize="12sp"/>
        <TextView android:layout_width="38dp" android:layout_height="wrap_content" android:text="OK" android:textColor="#BDBDBD" android:textStyle="bold" android:textSize="12sp" android:gravity="center"/>
        <TextView android:layout_width="30dp" android:layout_height="wrap_content" android:text="" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp"
        android:padding="10dp" android:orientation="vertical" android:background="#171717">

        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical">
            <TextView android:id="@+id/widget_comanda_numero" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.5"
                android:gravity="center_vertical" android:padding="12dp" android:text="Nº" android:textColor="#D0D0D0" android:textSize="18sp" android:background="#202020"/>
            <TextView android:id="@+id/widget_comanda_taxa" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_marginStart="8dp" android:gravity="center_vertical" android:padding="12dp" android:text="Taxa R$" android:textColor="#D0D0D0" android:textSize="18sp" android:background="#202020"/>
            <TextView android:id="@+id/widget_comanda_check" android:layout_width="38dp" android:layout_height="38dp" android:layout_marginStart="8dp"
                android:gravity="center" android:text="" android:textColor="#111111" android:textStyle="bold" android:textSize="25sp" android:background="#FFFFFF"/>
            <TextView android:id="@+id/widget_comanda_delete" android:layout_width="30dp" android:layout_height="45dp"
                android:gravity="center" android:text="×" android:textColor="#FF5252" android:textStyle="bold" android:textSize="30sp"/>
        </LinearLayout>

        <TextView android:id="@+id/widget_comanda_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="8dp" android:text="Pendente" android:textColor="#BDBDBD" android:textSize="13sp"/>
    </LinearLayout>
</LinearLayout>