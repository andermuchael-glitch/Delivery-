rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function admin() {
      return signedIn() && request.auth.token.email == 'entrega365.suporte@gmail.com';
    }

    match /entrega365Sync/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Independent private safety copy for each account.
    match /entrega365SafetyBackup/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /entrega365CommunityPosts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.authorUid == request.auth.uid;

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorUid == request.auth.uid;
        allow update, delete: if signedIn()
          && resource.data.authorUid == request.auth.uid;
      }
    }

    match /entrega365CommunitySettings/{settingId} {
      allow read: if signedIn();
      allow write: if admin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
