<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="#1B1B1B">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ENTREGA365 • HOJE"
        android:textColor="#FFD21A"
        android:textStyle="bold"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/widget_today_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0 entregas hoje"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/widget_today_earnings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="R$ 0,00"
                android:textColor="#4CD964"
                android:textStyle="bold"
                android:textSize="19sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_new_comanda"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center"
        android:text="+ NOVA COMANDA"
        android:textColor="#171717"
        android:textStyle="bold"
        android:textSize="14sp"
        android:background="@drawable/widget_quick_comanda_bg" />
</LinearLayout>